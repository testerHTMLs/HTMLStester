<script>
(() => {
  const STORAGE_KEY = "recentlyPlayedPerLocale";
  const FALLBACK_LIMIT = 12;

  const root = document.querySelector('[data-controller~="add-to-recently-played"]');
  const locale = (
    root?.dataset.addToRecentlyPlayedLocaleValue ||
    document.documentElement.lang ||
    "en"
  ).toLowerCase();

  const name =
    root?.dataset.addToRecentlyPlayedNameValue ||
    document.querySelector('meta[property="og:title"]')?.content ||
    document.querySelector("h1")?.textContent?.trim() ||
    document.title ||
    "Game";

  const image =
    root?.dataset.addToRecentlyPlayedImageValue ||
    document.querySelector('meta[property="og:image"]')?.content ||
    document.querySelector("img")?.src ||
    "";

  const rawUrl =
    root?.dataset.addToRecentlyPlayedUrlValue ||
    location.pathname;
  const url = rawUrl.replace(/\/+$/, "") + "/";

  const limit = Number(root?.dataset.addToRecentlyPlayedLimitValue || FALLBACK_LIMIT);

  if (!name || !image || !url) return;

  let stored = {};
  try {
    stored = JSON.parse(localStorage.getItem(STORAGE_KEY) || "{}");
  } catch {
    stored = {};
  }

  const list = Array.isArray(stored[locale]) ? stored[locale] : [];
  const deduped = list.filter((game) => game && game.url !== url);
  deduped.unshift({ name, image, url });
  stored[locale] = deduped.slice(0, Number.isFinite(limit) && limit > 0 ? limit : FALLBACK_LIMIT);

  localStorage.setItem(STORAGE_KEY, JSON.stringify(stored));
})();
</script>

<script>
(() => {
  const toggles = document.querySelectorAll('#fullscreen-btn, #fullscreen-exit-btn');
  if (!toggles.length) return;

  

  const wrapper = document.getElementById("fullscreen-wrapper");
  if (!wrapper) {
    console.error("Missing #fullscreen-wrapper");
    return;
  }
  if (!wrapper.hasAttribute("tabindex")) {
    wrapper.setAttribute("tabindex", "-1");
  }

    

  function isFullscreenOn() {
    return Boolean(
      document.fullscreenElement ||
      document.webkitFullscreenElement
    );
  }

  async function exitFullscreen() {
    if (document.exitFullscreen) return document.exitFullscreen();
    if (document.webkitExitFullscreen) return document.webkitExitFullscreen();
  }

  async function enterFullscreen(el) {
    el.focus({ preventScroll: true });
    if (el.requestFullscreen) return el.requestFullscreen();
    if (el.webkitRequestFullscreen) return el.webkitRequestFullscreen();
    throw new Error("Fullscreen API not supported");
  }

  function syncFullscreenState() {
    const active = isFullscreenOn();
    document.body.classList.toggle("isFullscreen", active);
    toggles.forEach(btn => btn.setAttribute("aria-pressed", active ? "true" : "false"));
  }

  async function toggleFullscreen(e) {
    e.preventDefault();
    try {
      if (isFullscreenOn()) {
        await exitFullscreen();
      } else {
        try {
          await enterFullscreen(wrapper);
        } catch (e) {
          const frame = document.getElementById("embed-frame");
          if (frame) {
            await enterFullscreen(frame);
          } else {
            throw e;
          }
        }

      }
    } catch (err) {
      console.error("Fullscreen toggle failed:", err);
    }
  }

  // Bind click handlers
  toggles.forEach(btn => btn.addEventListener("click", toggleFullscreen));

  // Listen for fullscreen changes
  ["fullscreenchange", "webkitfullscreenchange"].forEach(ev =>
    document.addEventListener(ev, syncFullscreenState)
  );

  syncFullscreenState();
})();
